/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */

/**
  * @brief  Report a touch once per press, in landscape coordinates.
  *
  * Returns 1 only on the first loop where a new finger is down, so one press
  * counts once instead of repeating while it is held.
  *
  * The touchscreen library hands back coordinates in the SCREEN_VERTICAL_1
  * frame (240 x 320).  If the screen is drawn in SCREEN_HORIZONTAL_1
  * (320 x 240) the point has to be rotated, which is what the two marked lines
  * do.  If touches land mirrored on your board, swap them for the alternatives
  * in the comments.
  */
static uint8_t Touch_Get_New_Press(uint16_t *x, uint16_t *y)
{
  static uint8_t was_pressed = 0;
  uint16_t position[2];

  if (!TP_Touchpad_Pressed())
  {
    was_pressed = 0;
    return 0;
  }

  if (was_pressed)
  {
    return 0;              /* still the same finger, ignore */
  }

  if (TP_Read_Coordinates(position) != TOUCHPAD_DATA_OK)
  {
    return 0;
  }

  was_pressed = 1;

  *x = position[1];                                 /* or (ILI9341_SCREEN_WIDTH  - 1) - position[1] */
  *y = (ILI9341_SCREEN_HEIGHT - 1) - position[0];   /* or position[0]                              */

  return 1;
}

/**
  * @brief  Read the potentiometer and drive the LCD backlight from 20 to 100 %.
  *         TIM4 is set up with ARR = 999, so the compare value is 0..999.
  */
static void Backlight_Set_From_Pot(void)
{
  uint32_t raw = 0;
  uint32_t duty_percent;

  HAL_ADC_Start(&hadc1);
  if (HAL_ADC_PollForConversion(&hadc1, 10) == HAL_OK)
  {
    raw = HAL_ADC_GetValue(&hadc1);
  }
  HAL_ADC_Stop(&hadc1);

  duty_percent = 20u + (raw * 80u) / 4095u;

  __HAL_TIM_SET_COMPARE(&htim4, TIM_CHANNEL_1,
                        duty_percent * (__HAL_TIM_GET_AUTORELOAD(&htim4) + 1u) / 100u);
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* Enable the CPU Cache */

  /* Enable I-Cache---------------------------------------------------------*/
  SCB_EnableICache();

  /* Enable D-Cache---------------------------------------------------------*/
  SCB_EnableDCache();

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_RNG_Init();
  MX_SPI5_Init();
  MX_TIM1_Init();
  MX_I2C1_Init();
  MX_ADC1_Init();
  MX_TIM4_Init();
  /* USER CODE BEGIN 2 */
  HAL_TIM_PWM_Start(&htim4, TIM_CHANNEL_1);

  am2320 = am2320_Init(&hi2c1, AM2320_ADDRESS);

  ILI9341_Init();
  ILI9341_Set_Rotation(SCREEN_HORIZONTAL_1);   /* 320 x 240, landscape */
  ILI9341_Fill_Screen(WHITE);

  /* ---------------------------------------------------------------------
     TODO: draw the fixed parts of screen 1 here
     --------------------------------------------------------------------- */

  uint32_t last_sensor    = 0;
  uint32_t last_backlight = 0;
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    uint32_t now = HAL_GetTick();
    uint16_t touch_x, touch_y;

    /* ---- backlight follows the potentiometer ---- */
    if (now - last_backlight >= 100u)
    {
      last_backlight = now;
      Backlight_Set_From_Pot();
    }

    /* ---- sensor, no faster than every 2 s ---- */
    if ((last_sensor == 0) || (now - last_sensor >= SENSOR_PERIOD_MS))
    {
      last_sensor = now;

      /* One transaction per pass.  Do not also call
         am2320_GetTemperatureAndHumidity() here - it performs a read of its
         own, which would break the 2 s spacing the sensor needs. */
      sensor_error = am2320_ReadValue(&am2320);

      if (sensor_error == 0)
      {
        /* data[2..3] = humidity, data[4..5] = temperature, both x10 */
        uint16_t raw_humidity    = ((uint16_t)am2320.data[2] << 8) | am2320.data[3];
        uint16_t raw_temperature = ((uint16_t)am2320.data[4] << 8) | am2320.data[5];

        humidity_x10 = raw_humidity;

        /* bit 15 is the sign */
        if (raw_temperature & 0x8000)
        {
          temperature_x10 = -(int16_t)(raw_temperature & 0x7FFF);
        }
        else
        {
          temperature_x10 = (int16_t)raw_temperature;
        }

        /* -----------------------------------------------------------------
           TODO: show temperature_x10 and humidity_x10 on the screen.
                 Both are in tenths, so 271 means 27.1
                 e.g. sprintf(buf, "%d.%d C", temperature_x10 / 10,
                                              temperature_x10 % 10);
           ----------------------------------------------------------------- */
      }
      else
      {
        /* sensor_error says where it went wrong:
           1 = the sensor refused the command (asleep? wiring? pull-ups?)
           2 = no answer came back
           3 = the reply did not look like an AM2320 frame              */
      }
    }

    /* ---- touch ---- */
    if (Touch_Get_New_Press(&touch_x, &touch_y))
    {
      /* -------------------------------------------------------------------
         TODO: touch_x / touch_y hold where the screen was pressed.
               Work out which circle was hit and react.
         ------------------------------------------------------------------- */
    }

    /* ---------------------------------------------------------------------
       TODO: screen 2 goes back to screen 1 after 5 s (SP3.2)
       --------------------------------------------------------------------- */

    HAL_Delay(20);
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

/**
  * @brief System Clock Configuration
  * @retval None
  */
void SystemClock_Config(void)
{
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

  /** Configure the main internal regulator output voltage
  */
  __HAL_RCC_PWR_CLK_ENABLE();
  __HAL_PWR_VOLTAGESCALING_CONFIG(PWR_REGULATOR_VOLTAGE_SCALE3);

  /** Initializes the RCC Oscillators according to the specified parameters
  * in the RCC_OscInitTypeDef structure.
  */
  RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSE;
  RCC_OscInitStruct.HSEState = RCC_HSE_BYPASS;
  RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
  RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSE;
  RCC_OscInitStruct.PLL.PLLM = 4;
  RCC_OscInitStruct.PLL.PLLN = 96;
  RCC_OscInitStruct.PLL.PLLP = RCC_PLLP_DIV2;
  RCC_OscInitStruct.PLL.PLLQ = 4;
  RCC_OscInitStruct.PLL.PLLR = 2;
  if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK)
  {
    Error_Handler();
  }

  /** Activate the Over-Drive mode
  */
  if (HAL_PWREx_EnableOverDrive() != HAL_OK)
  {
    Error_Handler();
  }

  /** Initializes the CPU, AHB and APB buses clocks
  */
  RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK|RCC_CLOCKTYPE_SYSCLK
                              |RCC_CLOCKTYPE_PCLK1|RCC_CLOCKTYPE_PCLK2;
  RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
  RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
  RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV2;
  RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV1;

  if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_3) != HAL_OK)
  {
    Error_Handler();
  }
}

